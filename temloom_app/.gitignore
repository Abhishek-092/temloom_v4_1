*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
chroma_db/
phase4-llm/chroma_db/
vmdata/
pgdata/
victoria-metrics-data/

# -----------------------------------------------------------------------------
# 4. Large Offline AI/ML Model Weights (GGUF, ONNX, PyTorch Binaries)
#    Lightweight JSON model parameters and Ed25519 signature manifests stay
#    tracked so the shipped models remain verifiable.
# -----------------------------------------------------------------------------
*.gguf
*.onnx
*.bin
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
*.h5
*.safetensors
saved_models/llm_gguf/
saved_models/embeddings/
saved_models/candidate_baselines/

!saved_models/model_g1_congestion_v4_1.json
!saved_models/model_g2_routing_v4_1.json
!saved_models/model_g3_tunnel_v4_1.json
!saved_models/model_g4_policy_v4_1.json
!saved_models/model_signatures.json
!saved_models/*.sig

