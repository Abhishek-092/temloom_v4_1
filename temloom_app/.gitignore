# -----------------------------------------------------------------------------
# 1. Cryptographic Private Keys & Secrets
#    Public verification keys (*.pub.pem) and signature manifests ARE committed.
# -----------------------------------------------------------------------------
keys/*
!keys/*.pub.pem
!keys/*.pub.json
!keys/README.md

.env
.env.*
!.env.example
!.env.sample
!.env.template
*.secret
secrets/

# -----------------------------------------------------------------------------
# 2. Python Bytecode, Virtual Environments & Packaging Caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.ipynb_checkpoints/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Pip artifacts
pip-log.txt
pip-delete-this-directory.txt

# Node.js (in case frontend dependencies are added)
node_modules/

# Docker runtime overrides
docker-compose.override.yml
.docker/

# Test, linter & type-checker caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# -----------------------------------------------------------------------------
